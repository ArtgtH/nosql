# Application environment variables
APP_PORT=8080
APP_BIND_IP=127.0.0.1
APP_USER_SESSION_TTL=60

# Redis connection
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Mongo connection
MONGODB_DATABASE=eventhub
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_HOST=mongos
MONGODB_PORT=27017

# Mongo internal ports
MONGO_CONFIGSVR_PORT=27019
MONGO_SHARD_PORT=27018
MONGO_ROUTER_PORT=27017
# Reactions cache TTL (seconds)
APP_LIKE_TTL=60

# Cassandra connection
CASSANDRA_HOSTS=cassandra-test
CASSANDRA_PORT=9042
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=
CASSANDRA_KEYSPACE=testkeyspace
CASSANDRA_CONSISTENCY=ONE